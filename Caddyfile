# TLS in front of the Klavio image. The app sets its own security headers
# (CSP, HSTS, Permissions-Policy …) and serves its files; Caddy only adds
# HTTPS and compression.
{$SITE_ADDRESS:localhost} {
	# "internal" = Caddy's local CA (development); an e-mail address = Let's Encrypt
	tls {$CADDY_TLS:internal}
	encode zstd gzip
	reverse_proxy app:3100
	header -Server
}
