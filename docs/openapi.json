                    "type": "integer",
                    "minimum": 1900,
                    "maximum": 9007199254740991
                  },
                  "world": {
                    "default": null,
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "kids",
                          "journey"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
