{
  "openapi": "3.1.0",
  "info": {
    "title": "Klavio API",
    "version": "unversioned",
    "description": "The API behind the Klavio web app. It is made for the app itself, not as a public API: it may change with every release.\n\nSign-in sets the httpOnly cookie `klavio_sid` (path `/api`). Requests that change something (POST, PUT, PATCH, DELETE) must carry an `Origin` header equal to the instance address, otherwise they get 403 `BAD_ORIGIN`.\n\nErrors are JSON: `{ \"error\": \"<CODE>\" }`; failed validation adds `issues`.",
    "license": {
      "name": "AGPL-3.0-only",
      "url": "https://www.gnu.org/licenses/agpl-3.0.html"
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "klavio_sid"
      }
    },
    "schemas": {}
  },
