    "/api/profiles/{id}": {
      "patch": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40,
                    "pattern": "^[^\\p{C}]+$"
                  },
                  "avatar": {
                    "type": "string",
                    "enum": [
                      "klavi",
                      "fox",
                      "owl",
                      "cat",
                      "bear",
                      "frog",
                      "whale"
                    ]
                  },
                  "uiMode": {
                    "type": "string",
                    "enum": [
                      "kids",
                      "classic"
                    ]
                  },
                  "dailyGoalMinutes": {
                    "type": "integer",
                    "minimum": 5,
                    "maximum": 60
                  },
                  "calibration": {
                    "type": "object",
                    "properties": {
                      "a4Hz": {
                        "default": 440,
                        "type": "number",
                        "minimum": 415,
                        "maximum": 466
                      },
                      "noiseFloorDb": {
                        "default": null,
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": -120,
                            "maximum": 0
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "inputGain": {
                        "default": 1,
                        "type": "number",
                        "minimum": 0.1,
                        "maximum": 10
                      }
                    }
                  },
                  "goalSong": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "title": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80
                          },
                          "style": {
                            "type": "string",
                            "enum": [
                              "ballad",
                              "pop",
                              "classical",
                              "film",
                              "melody"
                            ]
                          },
                          "skills": {
                            "maxItems": 20,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "white-keys",
                                "right-hand",
                                "treble-clef",
                                "note-values",
                                "melodies",
                                "left-hand",
                                "bass-clef",
                                "both-hands",
                                "grand-staff",
                                "black-keys",
                                "improvise",
                                "eighths",
                                "three-four",
                                "six-eight",
                                "dynamics",
                                "scales",
                                "minor",
                                "chords",
                                "arpeggios",
                                "pedal"
                              ]
                            }
                          }
                        },
                        "required": [
                          "title",
                          "style",
                          "skills"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "birthYear": {
                    "type": "integer",
                    "minimum": 1900,
                    "maximum": 9007199254740991
                  },
                  "world": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "kids",
                          "journey"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "outfit": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "cap",
                          "bow",
                          "glasses",
                          "scarf",
                          "headphones",
                          "crown"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "setupDone": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  },
                  "motive": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "read",
                          "songs",
                          "relax",
                          "fun",
                          "child"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "weeklyGoalDays": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 7
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "playOn": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "piano",
                          "screen"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{24}$"
            },
            "in": "path",
            "name": "id",
            "required": true
