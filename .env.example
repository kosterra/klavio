# Copy to .env and adjust. Never commit .env.

# >= 32 random characters, e.g.:  openssl rand -base64 48
AUTH_SECRET=change-me-change-me-change-me-change-me

# --- local development (npm run dev) ------------------------------------------
# Browser-visible origin and WebAuthn relying-party ID. http://localhost is a
# secure context, so passkeys work without TLS.
APP_ORIGIN=http://localhost:5173
RP_ID=localhost
COOKIE_SECURE=false
MONGO_URL=mongodb://localhost:27017/klavio

# Mail: Mailpit from docker compose (inbox at http://localhost:8026)
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_REQUIRE_TLS=false
MAIL_FROM=Klavio <no-reply@klavio.local>

# Initial value of the global "registration open" switch (admins can change it in the app)
REGISTRATION_OPEN_DEFAULT=true

# --- docker compose (full stack behind Caddy) ---------------------------------
# Hostname Caddy serves. "localhost" uses Caddy's local CA (trust it once, see README).
SITE_ADDRESS=localhost
# "internal" = local CA; for a public domain put your e-mail here to get a Let's Encrypt cert
CADDY_TLS=internal
HTTPS_PORT=8443
